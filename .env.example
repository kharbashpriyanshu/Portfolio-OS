# ==============================================================================
# PORTFOLIO OS v1.0 - ENVIRONMENT CONFIGURATION SCHEMA
# Owner: Priyanshu Kharbash
# ==============================================================================

# Application Metadata
VITE_APP_NAME="Portfolio OS"
VITE_APP_URL="http://localhost:3000"
VITE_APP_ENV="development"

# Feature Flags
VITE_ENABLE_DARK_MODE="true"
VITE_ENABLE_SEO_INDEXING="false"

# API & Integrations (Optional / Future Ready)
VITE_API_BASE_URL=""
VITE_ANALYTICS_ID=""

# ==============================================================================
# BACKEND & SECURE INBOX CONFIGURATION
# (Used by the FastAPI backend only. Never expose these in the frontend.)
# ==============================================================================

# Database Connection
# Local SQLite default: sqlite:///./portfolio.db
# PostgreSQL example: postgresql://postgres:password@localhost:5432/portfolio
DATABASE_URL=sqlite:///./portfolio.db

# Admin Authentication
ADMIN_USERNAME=admin
# Use passlib/bcrypt to generate this hash. Example is 'admin123'
ADMIN_PASSWORD_HASH="$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW"
SESSION_SECRET="generate-a-secure-random-string-here"
ENVIRONMENT=development
